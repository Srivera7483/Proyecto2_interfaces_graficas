  object ChartPM: TChart
    Left = 0
    Height = 320
    Top = 100
    Width = 700
    AxisList = <
      item
        Title.Caption = 'ug/m3'
        Title.LabelFont.Color = clDefault
        Title.Visible = True
      end
      item
        Alignment = calBottom
        Title.Caption = 'Muestras'
        Title.LabelFont.Color = clDefault
        Title.Visible = True
      end>
    BackColor = clBlack
    Title.Text.Strings = (
      'Series de Tiempo: PM1.0 / PM2.5 / PM10'
    )
    Title.Font.Color = clBlack
    TabOrder = 2
    object SerieMP01: TLineSeries
